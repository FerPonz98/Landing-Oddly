# Copiar a .env.local para desarrollo. En producción se configuran en Easypanel (Environment).
# Son variables NEXT_PUBLIC_: se incrustan en el build, así que si cambian hay que volver a desplegar.

# WhatsApp de Oddly: código de país + número, solo dígitos (sin +, espacios ni guiones).
# Lo usan todos los botones de contacto y el botón flotante. Si no tiene entre 8 y 15 dígitos, los botones
# llevan a la sección de contacto y el botón flotante no se muestra.
NEXT_PUBLIC_WHATSAPP_NUMBER=59177351263

# URL pública de la landing, con https y sin barra final.
# Se usa en Open Graph/Twitter, canonical y hreflang, JSON-LD, robots.txt y sitemap.xml.
# En desarrollo puede quedar como http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://oddly.com.bo
