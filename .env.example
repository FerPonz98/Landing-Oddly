# WhatsApp de Oddly: código de país y número, solo dígitos.
# La landing usa este número también como valor predeterminado.
# Configurar en .env.local y reiniciar desarrollo (o recompilar para producción).
NEXT_PUBLIC_WHATSAPP_NUMBER=59167443300

# URL pública al desplegar la landing, para las imágenes al compartir enlaces.
# En producción debe ser la URL pública con https y sin barra final (ej. https://oddly.com.bo).
# Como son variables NEXT_PUBLIC_, se incrustan en el build: si cambian, hay que redeployar.
NEXT_PUBLIC_SITE_URL=
