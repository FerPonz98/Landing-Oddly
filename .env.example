# Base URL of the backend that will receive the contact form.
# Leave empty and the form validates + confirms locally, with no network call.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: full endpoint override. Wins over NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# WhatsApp number for the "HABLEMOS" CTA. Digits only, no "+".
# Empty keeps the CTA pointing at the contact section instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Privacy policy route or URL used by the form checkbox.
NEXT_PUBLIC_PRIVACY_URL=
